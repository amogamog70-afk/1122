            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4),
            Parent = optionsContainer
        })
        
        local function updateMultiLayout()
            pcall(function()
                local totalH = (#options * 20) + 8
                optionsContainer.CanvasSize = UDim2.new(0, 0, 0, totalH)
                if optionsContainer.Visible then
                    local absPos = mainBtn.AbsolutePosition
                    local absSize = mainBtn.AbsoluteSize
                    optionsContainer.Size = UDim2.new(0, absSize.X, 0, math.min(totalH, 140))
                    optionsContainer.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
                end
            end)
        end

        for idx, opt in ipairs(options) do
            local optBtn = create("TextButton", {
                Size = UDim2.new(1, -6, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                TextSize = 11,
                TextColor3 = selectedMap[opt] and theme.TextActive or theme.TextInactive,
                Text = (selectedMap[opt] and "+ " or "- ") .. tostring(opt),
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 2001,
                Parent = optionsContainer
            })
            
            optBtn.MouseButton1Click:Connect(function()
                selectedMap[opt] = not selectedMap[opt]
                optBtn.Text = (selectedMap[opt] and "+ " or "- ") .. tostring(opt)
                optBtn.TextColor3 = selectedMap[opt] and theme.TextActive or theme.TextInactive
                btnText.Text = getSelectedString()
                if callback then pcall(callback, selectedMap) end
            end)
        end
        updateMultiLayout()
        
        mainBtn.MouseButton1Click:Connect(function()
            pcall(function()
                if activeColorPicker then activeColorPicker.Visible = false end
                optionsContainer.Visible = not optionsContainer.Visible
                if optionsContainer.Visible then
                    updateMultiLayout()
                end
            end)
        end)

        UserInputService.InputBegan:Connect(function(input)
            if optionsContainer.Visible and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                pcall(function()
                    local pos = input.Position
                    local btnPos = mainBtn.AbsolutePosition
                    local btnSize = mainBtn.AbsoluteSize
                    local optPos = optionsContainer.AbsolutePosition
                    local optSize = optionsContainer.AbsoluteSize

                    local inBtn = (pos.X >= btnPos.X and pos.X <= btnPos.X + btnSize.X and pos.Y >= btnPos.Y and pos.Y <= btnPos.Y + btnSize.Y)
                    local inOpt = (pos.X >= optPos.X and pos.X <= optPos.X + optSize.X and pos.Y >= optPos.Y and pos.Y <= optPos.Y + optSize.Y)

                    if not inBtn and not inOpt then
                        optionsContainer.Visible = false
                    end
                end)
            end
        end)
        
        local multiDropdownObj = {
            GetSelectedMap = function() return selectedMap end,
            SetOption = function(opt, st)
                selectedMap[opt] = st
                btnText.Text = getSelectedString()
                if callback then pcall(callback, selectedMap) end
            end
        }

        if text then
            registry[text] = { Type = "MultiDropdown", Object = multiDropdownObj }
        end

        return multiDropdownObj
    end

