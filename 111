local function protectScreenGui(gui)
    if not gui then return end
    pcall(function() gui.Archivable = false end)
    local protectFunc = (getgenv and (getgenv().protectgui or getgenv().protect_gui))
        or (syn and syn.protect_gui)
        or (typeof(protectgui) == "function" and protectgui)
        or (typeof(protect_gui) == "function" and protect_gui)
    if protectFunc then
        pcall(protectFunc, gui)
    end
end

local function getSafeParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    if CoreGui then
        local robloxGui = CoreGui:FindFirstChild("RobloxGui")
        if robloxGui then return robloxGui end
        return CoreGui
    end
    if LocalPlayer then
        local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
        if playerGui then return playerGui end
    end
    return nil
end

local function create(className, properties)
    local inst = Instance.new(className)
    inst.Name = getRandomName()
    if properties then
        for k, v in pairs(properties) do
            if k ~= "Name" then
                inst[k] = v
            end
        end
    end
    return inst
end

local activeColorPicker = nil
local activeCloseFunc = nil

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if activeColorPicker and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        local posX, posY = input.Position.X, input.Position.Y
        local pickerPos = activeColorPicker.AbsolutePosition
        local pickerSize = activeColorPicker.AbsoluteSize
        local btnPos = activeColorPicker.Parent and activeColorPicker.Parent.AbsolutePosition or Vector2.new(0,0)
        local btnSize = activeColorPicker.Parent and activeColorPicker.Parent.AbsoluteSize or Vector2.new(0,0)
        
        local inPicker = (posX >= pickerPos.X and posX <= pickerPos.X + pickerSize.X and posY >= pickerPos.Y and posY <= pickerPos.Y + pickerSize.Y)
        local inBtn = (posX >= btnPos.X and posX <= btnPos.X + btnSize.X and posY >= btnPos.Y and posY <= btnPos.Y + btnSize.Y)
        
        if not inPicker and not inBtn then
            if activeCloseFunc then
                activeCloseFunc()
            else
                activeColorPicker.Visible = false
                activeColorPicker = nil
            end
        end
    end
end)

local function makeDraggable(dragHandle, targetFrame)
    local dragging = false
    local dragInput, dragStart, startPos
    
    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if activeColorPicker then return end
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging and dragStart and startPos then
            if activeColorPicker then
                dragging = false
                return
            end
            local delta = input.Position - dragStart
            targetFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

