    -- Method: Window:AddToggle(columnParent, text, defaultState, callback)
    function Window:AddToggle(columnParent, text, defaultState, callback)
        local toggleFrame = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            Parent = columnParent or (Window.Tabs and Window.Tabs["Combat"] and Window.Tabs["Combat"].LeftColumn)
        })
        
        local state = defaultState or false
        
        local toggleBox = create("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 10, 0, 3),
            BackgroundColor3 = state and Color3.fromRGB(120, 77, 78) or Color3.fromRGB(22, 22, 28),
            BorderSizePixel = 0,
            Parent = toggleFrame
        })
        
        local toggleStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = state and Color3.fromRGB(185, 115, 117) or Color3.fromRGB(48, 48, 56),
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = toggleBox
        })
        
        local toggleLabel = create("TextLabel", {
            Size = UDim2.new(1, -32, 0, 20),
            Position = UDim2.new(0, 32, 0, 0),
            BackgroundTransparency = 1,
            Text = text or "Toggle",
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = state and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(150, 150, 165),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = toggleFrame
        })
        
        local function updateToggle(newState)
            state = newState
            local boxColor = state and Color3.fromRGB(120, 77, 78) or Color3.fromRGB(22, 22, 28)
            local strokeColor = state and Color3.fromRGB(185, 115, 117) or Color3.fromRGB(48, 48, 56)
            local textColor = state and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(150, 150, 165)
            
            TweenService:Create(toggleBox, TweenInfo.new(0.15), {BackgroundColor3 = boxColor}):Play()
            TweenService:Create(toggleStroke, TweenInfo.new(0.15), {Color = strokeColor}):Play()
            TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = textColor}):Play()
            
            if callback then
                pcall(callback, state)
            end
        end
        
        toggleFrame.MouseButton1Click:Connect(function()
            updateToggle(not state)
        end)
        
        toggleFrame.MouseEnter:Connect(function()
            if not state then
                TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(200, 200, 215)}):Play()
            end
        end)
        
        toggleFrame.MouseLeave:Connect(function()
            if not state then
                TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(150, 150, 165)}):Play()
            end
        end)
        
        local toggleObj = {}
        toggleObj.contentHeight = 20
        toggleObj.SetState = updateToggle
        toggleObj.GetState = function() return state end
        
        function toggleObj:AddKeybind(defaultKey, keyCallback)
            local keybindBtn = create("TextButton", {
                Size = UDim2.new(0, 44, 0, 16),
                Position = UDim2.new(1, -48, 0, 2),
                BackgroundColor3 = Color3.fromRGB(22, 22, 28),
                BorderSizePixel = 0,
                Font = Enum.Font.Code,
                TextSize = 11,
                TextColor3 = Color3.fromRGB(170, 170, 185),
                AutoButtonColor = false,
                Parent = toggleFrame
            })
            
            local keyStroke = create("UIStroke", {
                Thickness = 1.0,
                Color = Color3.fromRGB(48, 48, 56),
                LineJoinMode = Enum.LineJoinMode.Miter,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = keybindBtn
            })
            
            local currentKey = defaultKey or Enum.KeyCode.E
            local currentMode = "Toggle"
            local binding = false
            
            local function getKeyName(key)
                if not key then return "NONE" end
                if typeof(key) == "EnumItem" then
                    local name = key.Name
                    if name:sub(1, 11) == "MouseButton" then
                        return "MB" .. name:sub(12)
                    end
                    return name:upper()
                end
                return tostring(key):upper()
            end
            
            local function updateKeybindDisplay()
                if currentMode == "Always" then
                    keybindBtn.Text = "[ALWAYS]"
                    updateToggle(true)
                else
                    keybindBtn.Text = "[" .. getKeyName(currentKey) .. "]"
                end
                Window:UpdateKeybindInList(text or "Toggle", getKeyName(currentKey), currentMode)
            end
            
            updateKeybindDisplay()
            
            local modePopup = create("Frame", {
                Size = UDim2.new(0, 70, 0, 0),
                Position = UDim2.new(1, 4, 0, 0),
                BackgroundColor3 = Color3.fromRGB(14, 14, 18),
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 50,
                Parent = keybindBtn
            })
            
            local popupStroke = create("UIStroke", {
                Thickness = 1.0,
                Color = Color3.fromRGB(120, 77, 78),
                LineJoinMode = Enum.LineJoinMode.Miter,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = modePopup
            })
            
            local modeLayout = create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
                Parent = modePopup
            })
            
            local modePadding = create("UIPadding", {
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4),
                PaddingRight = UDim.new(0, 4),
                Parent = modePopup
            })
            
            local modes = {"Always", "Toggle", "Hold"}
            for idx, modeName in ipairs(modes) do
                local mBtn = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.Code,
                    TextSize = 11,
                    TextColor3 = (modeName == currentMode) and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(140, 140, 155),
                    Text = modeName,
                    ZIndex = 51,
                    Parent = modePopup
                })
                
                mBtn.MouseButton1Click:Connect(function()
                    currentMode = modeName
                    updateKeybindDisplay()
                    modePopup.Visible = false
                end)
            end
            
            keybindBtn.MouseButton1Click:Connect(function()
                if binding then return end
                binding = true
                keybindBtn.Text = "[...]"
                keybindBtn.TextColor3 = Color3.fromRGB(245, 195, 68)
                
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                        currentKey = input.KeyCode
                        binding = false
                        conn:Disconnect()
                        keybindBtn.TextColor3 = Color3.fromRGB(170, 170, 185)
                        updateKeybindDisplay()
                        if keyCallback then pcall(keyCallback, currentKey) end
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                        currentKey = input.UserInputType
                        binding = false
                        conn:Disconnect()
                        keybindBtn.TextColor3 = Color3.fromRGB(170, 170, 185)
                        updateKeybindDisplay()
                        if keyCallback then pcall(keyCallback, currentKey) end
                    end
                end)
            end)
            
            keybindBtn.MouseButton2Click:Connect(function()
                modePopup.Size = UDim2.new(0, 70, 0, 58)
                modePopup.Visible = not modePopup.Visible
            end)
            
            UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed or binding then return end
                if currentMode == "Always" then return end
                
                local isTriggered = false
                if typeof(currentKey) == "EnumItem" then
                    if input.KeyCode == currentKey or input.UserInputType == currentKey then
                        isTriggered = true
                    end
                end
                
                if isTriggered then
                    if currentMode == "Toggle" then
                        updateToggle(not state)
                    elseif currentMode == "Hold" then
                        updateToggle(true)
                    end
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input, gameProcessed)
                if currentMode == "Hold" and typeof(currentKey) == "EnumItem" then
                    if input.KeyCode == currentKey or input.UserInputType == currentKey then
                        updateToggle(false)
                    end
                end
            end)
            
            return {
                SetKey = function(newKey) currentKey = newKey; updateKeybindDisplay() end,
                SetMode = function(newMode) currentMode = newMode; updateKeybindDisplay() end
            }
        end

        function toggleObj:AddColorPicker(defaultColor, colorCallback)
            local currentColor = defaultColor or Color3.fromRGB(255, 255, 255)
            
            local pickerBtn = create("TextButton", {
                Size = UDim2.new(0, 24, 0, 14),
                Position = UDim2.new(1, -28, 0, 3),
                BackgroundColor3 = currentColor,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Parent = toggleFrame
            })
            
            local pickerStroke = create("UIStroke", {
                Thickness = 1.0,
                Color = Color3.fromRGB(48, 48, 56),
                LineJoinMode = Enum.LineJoinMode.Miter,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = pickerBtn
            })
            
            local pickerPopup = create("Frame", {
                Size = UDim2.new(0, 180, 0, 160),
                Position = UDim2.new(1, 6, 0, 0),
                BackgroundColor3 = Color3.fromRGB(14, 14, 18),
                BorderSizePixel = 0,
                Visible = false,
                ZIndex = 200,
                Parent = pickerBtn
            })
            
            local popStroke = create("UIStroke", {
                Thickness = 1.4,
                Color = Color3.fromRGB(120, 77, 78),
                LineJoinMode = Enum.LineJoinMode.Miter,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = pickerPopup
            })
            
            local satValMap = create("ImageLabel", {
                Size = UDim2.new(0, 140, 0, 120),
                Position = UDim2.new(0, 8, 0, 8),
                Image = "rbxassetid://4155801252",
                BackgroundColor3 = Color3.fromRGB(255, 0, 0),
                BorderSizePixel = 0,
                ZIndex = 201,
                Parent = pickerPopup
            })
            
            local mapCursor = create("Frame", {
                Size = UDim2.new(0, 6, 0, 6),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(1, 0, 0, 0),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0,
                ZIndex = 202,
                Parent = satValMap
            })
            
            local hueBar = create("ImageLabel", {
                Size = UDim2.new(0, 14, 0, 120),
                Position = UDim2.new(0, 156, 0, 8),
                Image = "rbxassetid://328298876",
                BorderSizePixel = 0,
                ZIndex = 201,
                Parent = pickerPopup
            })
            
            local hueCursor = create("Frame", {
                Size = UDim2.new(1, 2, 0, 3),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0, 0),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0,
                ZIndex = 202,
                Parent = hueBar
            })
            
            local hexInput = create("TextBox", {
                Size = UDim2.new(0, 162, 0, 20),
                Position = UDim2.new(0, 8, 0, 134),
                BackgroundColor3 = Color3.fromRGB(20, 20, 26),
                BorderSizePixel = 0,
                Font = Enum.Font.Code,
                TextSize = 12,
                TextColor3 = Color3.fromRGB(240, 240, 245),
                Text = "#" .. currentColor:ToHex():upper(),
                ZIndex = 201,
                Parent = pickerPopup
            })
            
            local currentH, currentS, currentV = currentColor:ToHSV()
            
            local function updateColor(h, s, v, source)
                currentH, currentS, currentV = h or currentH, s or currentS, v or currentV
                currentColor = Color3.fromHSV(currentH, currentS, currentV)
                pickerBtn.BackgroundColor3 = currentColor
                satValMap.BackgroundColor3 = Color3.fromHSV(currentH, 1, 1)
                
                if source ~= "hex" then
                    hexInput.Text = "#" .. currentColor:ToHex():upper()
                end
                
                if colorCallback then pcall(colorCallback, currentColor) end
            end
            
            local draggingSatVal = false
            satValMap.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSatVal = true
                end
            end)
            
            local draggingHue = false
            hueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingHue = true
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSatVal = false
                    draggingHue = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if draggingSatVal then
                        local absPos = satValMap.AbsolutePosition
                        local absSize = satValMap.AbsoluteSize
                        local relX = math.clamp((input.Position.X - absPos.X) / absSize.X, 0, 1)
                        local relY = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
                        mapCursor.Position = UDim2.new(relX, 0, relY, 0)
                        updateColor(currentH, relX, 1 - relY)
                    elseif draggingHue then
                        local absPos = hueBar.AbsolutePosition
                        local absSize = hueBar.AbsoluteSize
                        local relY = math.clamp((input.Position.Y - absPos.Y) / absSize.Y, 0, 1)
                        hueCursor.Position = UDim2.new(0.5, 0, relY, 0)
                        updateColor(1 - relY, currentS, currentV)
                    end
                end
            end)
            
            hexInput.FocusLost:Connect(function()
                local text = hexInput.Text:gsub("#", "")
                local ok, col = pcall(function() return Color3.fromHex(text) end)
                if ok and col then
                    local h, s, v = col:ToHSV()
                    mapCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueCursor.Position = UDim2.new(0.5, 0, 1 - h, 0)
                    updateColor(h, s, v, "hex")
                end
            end)
            
            pickerBtn.MouseButton1Click:Connect(function()
                if activeColorPicker and activeColorPicker ~= pickerPopup then
                    activeColorPicker.Visible = false
                end
                pickerPopup.Visible = not pickerPopup.Visible
                if pickerPopup.Visible then
                    activeColorPicker = pickerPopup
                    activeCloseFunc = function()
                        pickerPopup.Visible = false
                        activeColorPicker = nil
                    end
                else
                    activeColorPicker = nil
                end
            end)
            
            return {
                SetColor = function(newColor)
                    local h, s, v = newColor:ToHSV()
                    mapCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueCursor.Position = UDim2.new(0.5, 0, 1 - h, 0)
                    updateColor(h, s, v)
                end
            }
        end
        
        return toggleObj
    end
    
    -- Method: Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
    function Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
        local parentCol = columnParent or Window.LeftColumn
        if typeof(text) == "number" then
            callback = suffix
            suffix = defaultVal
            defaultVal = max
            max = min
            min = text
            text = "Slider"
        end
        
        min = min or 0
        max = max or 100
        defaultVal = math.clamp(defaultVal or min, min, max)
        suffix = suffix or ""
        
        local sliderFrame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Parent = parentCol
        })
        
        local titleLbl = create("TextLabel", {
            Size = UDim2.new(0.6, 0, 0, 18),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(200, 200, 215),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = text or "Slider",
            Parent = sliderFrame
        })
        
        local valueLbl = create("TextLabel", {
            Size = UDim2.new(0.4, -10, 0, 18),
            Position = UDim2.new(0.6, 0, 0, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(160, 160, 175),
            TextXAlignment = Enum.TextXAlignment.Right,
            Text = tostring(defaultVal) .. suffix,
            Parent = sliderFrame
        })
        
        local trackFrame = create("TextButton", {
            Size = UDim2.new(1, -20, 0, 12),
            Position = UDim2.new(0, 10, 0, 20),
            BackgroundColor3 = Color3.fromRGB(22, 22, 28),
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            Parent = sliderFrame
        })
        
        local trackStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = Color3.fromRGB(48, 48, 56),
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = trackFrame
        })
        
        local fillRatio = (defaultVal - min) / (max - min)
        local fillFrame = create("Frame", {
            Size = UDim2.new(fillRatio, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(120, 77, 78),
            BorderSizePixel = 0,
            Parent = trackFrame
        })
        
        local val = defaultVal
        local dragging = false
        
        local function updateSlider(inputPos)
            local absPos = trackFrame.AbsolutePosition.X
            local absSize = trackFrame.AbsoluteSize.X
            local relX = math.clamp((inputPos - absPos) / absSize, 0, 1)
            val = math.floor(min + (max - min) * relX + 0.5)
            val = math.clamp(val, min, max)
            
            local newRatio = (val - min) / (max - min)
            fillFrame.Size = UDim2.new(newRatio, 0, 1, 0)
            valueLbl.Text = tostring(val) .. suffix
            
            if callback then pcall(callback, val) end
        end
        
        trackFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateSlider(input.Position.X)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position.X)
            end
        end)
        
        return {
            SetValue = function(newVal)
                val = math.clamp(newVal, min, max)
                local r = (val - min) / (max - min)
                fillFrame.Size = UDim2.new(r, 0, 1, 0)
                valueLbl.Text = tostring(val) .. suffix
                if callback then pcall(callback, val) end
            end,
            GetValue = function() return val end
        }
    end
    
