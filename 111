            PaddingBottom = UDim.new(0, 4),
            PaddingLeft = UDim.new(0, 4),
            PaddingRight = UDim.new(0, 4),
            Parent = optionsContainer
        })
        
        local function updateContainerLayout()
            pcall(function()
                local totalH = (#options * 20) + 8
                optionsContainer.CanvasSize = UDim2.new(0, 0, 0, totalH)
                if optionsContainer.Visible then
                    local absPos = mainBtn.AbsolutePosition
                    local absSize = mainBtn.AbsoluteSize
                    optionsContainer.Size = UDim2.new(0, absSize.X, 0, math.min(totalH, 140))
                    optionsContainer.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
                end
            end)
        end

        local function rebuildOptions()
            pcall(function()
                for _, child in ipairs(optionsContainer:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for idx, opt in ipairs(options) do
                    local optBtn = create("TextButton", {
                        Size = UDim2.new(1, -6, 0, 18),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Code,
