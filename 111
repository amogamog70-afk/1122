    -- Method: Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
    function Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
        if type(min) == "string" then
            local tempText = min
            local tempMin = max
            local tempMax = defaultVal
            local tempDef = suffix
            local tempSuf = callback
            text = tempText
            min = tempMin or 0
            max = tempMax or 100
            defaultVal = tempDef or min
            suffix = tempSuf or ""
            callback = arguments and arguments[6]
        end
        
        min = min or 0
        max = max or 100
        defaultVal = math.clamp(defaultVal or min, min, max)
        suffix = suffix or ""
        
        local sliderFrame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Parent = columnParent or (Window.Tabs and Window.Tabs["Rage"] and Window.Tabs["Rage"].LeftColumn)
        })
        
        local sliderLabel = create("TextLabel", {
            Size = UDim2.new(0.65, 0, 0, 16),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = text or "Slider",
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = theme.TextActive,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = sliderFrame
        })
        themeElements.TextActiveLabels[sliderLabel] = true
        
        local valueLabel = create("TextLabel", {
            Size = UDim2.new(0.35, -10, 0, 16),
            Position = UDim2.new(0.65, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = tostring(defaultVal) .. suffix,
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = theme.SecondaryAccent,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = sliderFrame
        })
        themeElements.SecondaryAccentText[valueLabel] = true
        
        local track = create("TextButton", {
            Size = UDim2.new(1, -20, 0, 8),
            Position = UDim2.new(0, 10, 0, 20),
            BackgroundColor3 = theme.ControlBG,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            Parent = sliderFrame
        })
        
        local trackStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = theme.ControlBorder,
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = track
        })
        
        local fillPercent = (defaultVal - min) / math.max(1, max - min)
        local fill = create("Frame", {
            Size = UDim2.new(fillPercent, 0, 1, 0),
            BackgroundColor3 = theme.PrimaryAccent,
            BorderSizePixel = 0,
            Parent = track
        })
        themeElements.PrimaryAccentFills[fill] = true
        
        local fillStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = theme.SecondaryAccent,
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = fill
        })
        themeElements.SecondaryAccentStrokes[fillStroke] = true
        
        local currentValue = defaultVal
        local sliding = false
        
        local function updateSlider(inputPos)
            pcall(function()
                local trackAbsPos = track.AbsolutePosition.X
                local trackAbsSize = track.AbsoluteSize.X
                local relX = math.clamp(inputPos.X - trackAbsPos, 0, trackAbsSize)
                local pct = relX / trackAbsSize
                
                currentValue = math.floor(min + (max - min) * pct + 0.5)
                currentValue = math.clamp(currentValue, min, max)
                
                fill.Size = UDim2.new(pct, 0, 1, 0)
                valueLabel.Text = tostring(currentValue) .. suffix
                
                if callback then
                    pcall(callback, currentValue)
                end
            end)
        end
        
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                updateSlider(input.Position)
            end
        end)
        
        track.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position)
            end
        end)
        
        local sliderObj = {
            SetValue = function(val)
                currentValue = math.clamp(val, min, max)
                local pct = (currentValue - min) / math.max(1, max - min)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                valueLabel.Text = tostring(currentValue) .. suffix
                if callback then pcall(callback, currentValue) end
            end,
            GetValue = function() return currentValue end
        }

        if text then
            registry[text] = { Type = "Slider", Object = sliderObj }
        end

        return sliderObj
    end

