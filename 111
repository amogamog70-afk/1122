                Color3.fromRGB(0, 245, 212)     -- Electric Aqua
            }
            
            local colorSquareStrokes = {}
            
            local function selectColor(newColor, isCustomHex)
                currentColor = newColor
                pickerBtn.BackgroundColor3 = currentColor
                if not isCustomHex then
                    pcall(function()
                        hexInput.Text = "#" .. currentColor:ToHex():upper()
                    end)
                end
                
                -- Update active strokes on squares
                for c, stroke in pairs(colorSquareStrokes) do
                    if c == currentColor then
                        stroke.Color = Color3.fromRGB(255, 255, 255)
                        stroke.Thickness = 1.6
                    else
                        stroke.Color = Color3.fromRGB(38, 38, 46)
                        stroke.Thickness = 1.0
                    end
                end
                
                if colorCallback then
                    safeCallback(colorCallback, currentColor)
                end
            end
            
            for i, col in ipairs(presetColors) do
                local sq = create("TextButton", {
                    BackgroundColor3 = col,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    LayoutOrder = i,
                    ZIndex = 202,
                    Parent = gridFrame
                })
                
                local sqStroke = create("UIStroke", {
                    Thickness = (col == currentColor) and 1.6 or 1.0,
                    Color = (col == currentColor) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(38, 38, 46),
                    LineJoinMode = Enum.LineJoinMode.Miter,
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                    Parent = sq
                })
                
                colorSquareStrokes[col] = sqStroke
                
                sq.MouseButton1Click:Connect(function()
                    selectColor(col, false)
                end)
                
                sq.MouseEnter:Connect(function()
                    if col ~= currentColor then
                        sqStroke.Color = Color3.fromRGB(160, 160, 180)
                    end
                end)
                sq.MouseLeave:Connect(function()
                    if col ~= currentColor then
                        sqStroke.Color = Color3.fromRGB(38, 38, 46)
                    end
                end)
            end
            
            hexInput.FocusLost:Connect(function(enterPressed)
                local txt = hexInput.Text:gsub("#", "")
                if #txt == 6 then
                    local ok, col = pcall(function() return Color3.fromHex(txt) end)
                    if ok and col then
                        selectColor(col, true)
                    end
                end
            end)
            
            pickerBtn.MouseButton1Click:Connect(function()
                if activeColorPicker and activeColorPicker ~= pickerPopup then
                    activeColorPicker.Visible = false
                end
                pickerPopup.Visible = not pickerPopup.Visible
                if pickerPopup.Visible then
                    activeColorPicker = pickerPopup
                    activeCloseFunc = function()
                        pickerPopup.Visible = false
                        activeColorPicker = nil
                        activeCloseFunc = nil
                    end
                else
                    activeColorPicker = nil
                    activeCloseFunc = nil
                end
            end)
            
            return {
                SetColor = function(newColor)
                    selectColor(newColor, false)
                end,
                GetColor = function()
                    return currentColor
                end
            }
        end
        
        return toggleObj
    end
    
    -- Method: Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
    function Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
        local parentCol = columnParent or Window.LeftColumn
        if typeof(text) == "number" then
            callback = suffix
            suffix = defaultVal
            defaultVal = max
            max = min
            min = text
            text = "Slider"
        end
        
        min = min or 0
        max = max or 100
        defaultVal = math.clamp(defaultVal or min, min, max)
        suffix = suffix or ""
        
        local sliderFrame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Parent = parentCol
        })
        
        local titleLbl = create("TextLabel", {
            Size = UDim2.new(0.6, 0, 0, 18),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(200, 200, 215),
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = text or "Slider",
            Parent = sliderFrame
        })
        
        local valueLbl = create("TextLabel", {
            Size = UDim2.new(0.4, -10, 0, 18),
            Position = UDim2.new(0.6, 0, 0, 0),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            TextSize = 12,
            TextColor3 = Color3.fromRGB(160, 160, 175),
            TextXAlignment = Enum.TextXAlignment.Right,
            Text = tostring(defaultVal) .. suffix,
            Parent = sliderFrame
        })
        
        local trackFrame = create("TextButton", {
            Size = UDim2.new(1, -20, 0, 12),
            Position = UDim2.new(0, 10, 0, 20),
            BackgroundColor3 = Color3.fromRGB(22, 22, 28),
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            Parent = sliderFrame
        })
        
        local trackStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = Color3.fromRGB(48, 48, 56),
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = trackFrame
        })
        
        local fillRatio = (defaultVal - min) / (max - min)
        local fillFrame = create("Frame", {
            Size = UDim2.new(fillRatio, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(120, 77, 78),
            BorderSizePixel = 0,
            Parent = trackFrame
        })
        
        local val = defaultVal
        local dragging = false
        
        local function updateSlider(inputPos, isRelease)
            local absPos = trackFrame.AbsolutePosition.X
            local absSize = trackFrame.AbsoluteSize.X
            local relX = math.clamp((inputPos - absPos) / absSize, 0, 1)
            val = math.floor(min + (max - min) * relX + 0.5)
            val = math.clamp(val, min, max)
            
            local newRatio = (val - min) / (max - min)
            fillFrame.Size = UDim2.new(newRatio, 0, 1, 0)
            valueLbl.Text = tostring(val) .. suffix
            
            -- BAC Safe Deferred Slider Execution: Only fire callback when user releases mouse/touch or sets value programmatically!
            if isRelease then
                if callback then pcall(callback, val) end
            end
        end
        
        trackFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateSlider(input.Position.X, true)
            end
        end)
        
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    updateSlider(input.Position.X, true)
                end
                dragging = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position.X, false)
            end
        end)
        
        return {
            SetValue = function(newVal)
                val = math.clamp(newVal, min, max)
                local r = (val - min) / (max - min)
                fillFrame.Size = UDim2.new(r, 0, 1, 0)
                valueLbl.Text = tostring(val) .. suffix
                if callback then pcall(callback, val) end
            end,
            GetValue = function() return val end
        }
    end
    
