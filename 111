    Window.KeybindListFrame = keybindFrame
    Window.SetKeybindListVisibility = Window.SetKeybindListVisibility
    Window.UpdateKeybindInList = Window.UpdateKeybindInList
    Window.SaveConfig = Window.SaveConfig
    Window.LoadConfig = Window.LoadConfig
    Window.DeleteConfig = Window.DeleteConfig
    Window.GetSavedConfigs = Window.GetSavedConfigs
    
    return Window
end

