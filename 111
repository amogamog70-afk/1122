                    local btnPos = mainBtn.AbsolutePosition
                    local btnSize = mainBtn.AbsoluteSize
                    local optPos = optionsContainer.AbsolutePosition
                    local optSize = optionsContainer.AbsoluteSize

                    local inBtn = (pos.X >= btnPos.X and pos.X <= btnPos.X + btnSize.X and pos.Y >= btnPos.Y and pos.Y <= btnPos.Y + btnSize.Y)
                    local inOpt = (pos.X >= optPos.X and pos.X <= optPos.X + optSize.X and pos.Y >= optPos.Y and pos.Y <= optPos.Y + optSize.Y)

                    if not inBtn and not inOpt then
                        optionsContainer.Visible = false
                    end
                end)
            end
        end)
        
        local dropdownObj = {
            SetSelected = function(val)
                if typeof(val) == "table" then
                    val = val[1] or ""
                end
                selected = tostring(val or "")
                btnText.Text = selected
                rebuildOptions()
                if callback then pcall(callback, selected) end
            end,
            GetSelected = function() return selected end,
            SetOptions = function(newOpts)
                options = (type(newOpts) == "table" and newOpts) or {}
                if not table.find(options, selected) then
                    selected = options[1] or ""
                    btnText.Text = tostring(selected)
                end
                rebuildOptions()
            end
        }

        if text then
            registry[text] = { Type = "Dropdown", Object = dropdownObj }
        end

        return dropdownObj
    end

