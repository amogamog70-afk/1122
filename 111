-- Anti-Cheat Countermeasures & Protection Utilities
local cloneFunc = (typeof(clonefunction) == "function" and clonefunction) or function(f) return f end
local safeGetService = cloneFunc(game.GetService)
local safeInstanceNew = cloneFunc(Instance.new)

local function getRandomName()
    local chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    local result = table.create(28)
    for i = 1, math.random(22, 34) do
        local r = math.random(1, #chars)
        result[i] = string.sub(chars, r, r)
    end
    return table.concat(result)
end

local function safeClone(serviceName)
    local s = safeGetService(game, serviceName)
    if typeof(cloneref) == "function" then
        local ok, ref = pcall(cloneref, s)
        if ok and ref then return ref end
    end
    return s
end

