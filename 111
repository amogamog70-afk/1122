    -- Method: Window:AddToggle(columnParent, text, defaultState, callback)
    function Window:AddToggle(columnParent, text, defaultState, callback)
        local toggleFrame = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            Parent = columnParent or (Window.Tabs and Window.Tabs["Combat"] and Window.Tabs["Combat"].LeftColumn)
        })
        
        local state = defaultState or false
        local activeKeybindUpdateFunc = nil
        
        local toggleBox = create("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 10, 0, 3),
            BackgroundColor3 = state and Color3.fromRGB(120, 77, 78) or Color3.fromRGB(22, 22, 28),
            BorderSizePixel = 0,
            Parent = toggleFrame
        })
        
        local toggleStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = state and Color3.fromRGB(185, 115, 117) or Color3.fromRGB(48, 48, 56),
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = toggleBox
        })
        
        local toggleLabel = create("TextLabel", {
            Size = UDim2.new(1, -85, 0, 20),
            Position = UDim2.new(0, 32, 0, 0),
            BackgroundTransparency = 1,
            Text = text or "Toggle",
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = state and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(150, 150, 165),
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = toggleFrame
        })
        
        local function updateToggle(newState)
            state = newState
            local boxColor = state and Color3.fromRGB(120, 77, 78) or Color3.fromRGB(22, 22, 28)
            local strokeColor = state and Color3.fromRGB(185, 115, 117) or Color3.fromRGB(48, 48, 56)
            local textColor = state and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(150, 150, 165)
            
            TweenService:Create(toggleBox, TweenInfo.new(0.15), {BackgroundColor3 = boxColor}):Play()
            TweenService:Create(toggleStroke, TweenInfo.new(0.15), {Color = strokeColor}):Play()
            TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = textColor}):Play()
            
            if activeKeybindUpdateFunc then
                activeKeybindUpdateFunc(state)
            end
            
            if callback then
                pcall(callback, state)
            end
        end
        
        toggleFrame.MouseButton1Click:Connect(function()
            updateToggle(not state)
        end)
        
        toggleFrame.MouseEnter:Connect(function()
            if not state then
                TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(200, 200, 215)}):Play()
            end
        end)
        
        toggleFrame.MouseLeave:Connect(function()
            if not state then
                TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = Color3.fromRGB(150, 150, 165)}):Play()
            end
        end)
        
        local toggleObj = {}
        toggleObj.contentHeight = 20
        toggleObj.SetState = updateToggle
        toggleObj.GetState = function() return state end
        
        local keybindBtnRef = nil
        local pickerBtnRef = nil
        
        local function updateSubControlPositions()
            if pickerBtnRef and keybindBtnRef then
                pickerBtnRef.Position = UDim2.new(1, -26, 0, 3)
                keybindBtnRef.Position = UDim2.new(1, -74, 0, 2)
            elseif pickerBtnRef then
                pickerBtnRef.Position = UDim2.new(1, -26, 0, 3)
            elseif keybindBtnRef then
                keybindBtnRef.Position = UDim2.new(1, -48, 0, 2)
            end
        end
        
        function toggleObj:AddKeybind(defaultKey, keyCallback)
            local keybindBtn = create("TextButton", {
                Size = UDim2.new(0, 44, 0, 16),
                Position = UDim2.new(1, -48, 0, 2),
                BackgroundColor3 = Color3.fromRGB(22, 22, 28),
                BorderSizePixel = 0,
                Font = Enum.Font.Code,
                TextSize = 11,
                TextColor3 = Color3.fromRGB(170, 170, 185),
                AutoButtonColor = false,
                Parent = toggleFrame
            })
            
            keybindBtnRef = keybindBtn
            updateSubControlPositions()
            
            local keyStroke = create("UIStroke", {
                Thickness = 1.0,
                Color = Color3.fromRGB(48, 48, 56),
                LineJoinMode = Enum.LineJoinMode.Miter,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = keybindBtn
            })
            
            local currentKey = defaultKey
            local currentMode = "Toggle"
            local binding = false
            local lastClickTime = 0
            
            local function getKeyName(key)
                if not key then return "NONE" end
                if typeof(key) == "EnumItem" then
                    local name = key.Name
                    if name:sub(1, 11) == "MouseButton" then
                        return "MB" .. name:sub(12)
                    end
                    return name:upper()
                end
                return tostring(key):upper()
            end
            
            local function updateKeybindDisplay(isActiveOverride)
                local keyStr = getKeyName(currentKey)
                local active = (isActiveOverride ~= nil) and isActiveOverride or state
                if not currentKey or keyStr == "NONE" then
                    keybindBtn.Text = "[NONE]"
                    Window:UpdateKeybindInList(text or "Toggle", "NONE", currentMode, false)
                elseif currentMode == "Always" then
                    keybindBtn.Text = "[ALWAYS]"
                    if not state then updateToggle(true) else Window:UpdateKeybindInList(text or "Toggle", keyStr, currentMode, true) end
                else
                    keybindBtn.Text = "[" .. keyStr .. "]"
                    Window:UpdateKeybindInList(text or "Toggle", keyStr, currentMode, active)
                end
            end
            
            activeKeybindUpdateFunc = function(activeState)
                updateKeybindDisplay(activeState)
            end
            
            updateKeybindDisplay(state)
            
            local modePopup = create("Frame", {
                Size = UDim2.new(0, 70, 0, 0),
                Position = UDim2.new(1, 4, 0, 0),
                BackgroundColor3 = Color3.fromRGB(14, 14, 18),
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
                ZIndex = 50,
                Parent = keybindBtn
            })
            
            local popupStroke = create("UIStroke", {
                Thickness = 1.0,
                Color = Color3.fromRGB(120, 77, 78),
                LineJoinMode = Enum.LineJoinMode.Miter,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = modePopup
            })
            
            local modeLayout = create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
                Parent = modePopup
            })
            
            local modePadding = create("UIPadding", {
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4),
                PaddingRight = UDim.new(0, 4),
                Parent = modePopup
            })
            
            local modes = {"Always", "Toggle", "Hold"}
            for idx, modeName in ipairs(modes) do
                local mBtn = create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Font = Enum.Font.Code,
                    TextSize = 11,
                    TextColor3 = (modeName == currentMode) and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(140, 140, 155),
                    Text = modeName,
                    ZIndex = 51,
                    Parent = modePopup
                })
                
                mBtn.MouseButton1Click:Connect(function()
                    currentMode = modeName
                    if currentMode == "Always" then
                        updateToggle(true)
                    end
                    updateKeybindDisplay(state)
                    modePopup.Visible = false
                end)
            end
            
            keybindBtn.MouseButton1Click:Connect(function()
                local now = os.clock()
                if now - lastClickTime < 0.35 then
                    -- Double Left Click Reset / Clear Keybind
                    binding = false
                    currentKey = nil
                    keybindBtn.Text = "[NONE]"
                    keybindBtn.TextColor3 = Color3.fromRGB(170, 170, 185)
                    Window:UpdateKeybindInList(text or "Toggle", "NONE", currentMode, false)
                    if keyCallback then pcall(keyCallback, nil) end
                    lastClickTime = 0
                    return
                end
                lastClickTime = now
                
                if binding then return end
                binding = true
                keybindBtn.Text = "[...]"
                keybindBtn.TextColor3 = Color3.fromRGB(245, 195, 68)
                
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
                        currentKey = input.KeyCode
                        binding = false
                        conn:Disconnect()
                        keybindBtn.TextColor3 = Color3.fromRGB(170, 170, 185)
                        updateKeybindDisplay(state)
                        if keyCallback then pcall(keyCallback, currentKey) end
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                        currentKey = input.UserInputType
                        binding = false
                        conn:Disconnect()
                        keybindBtn.TextColor3 = Color3.fromRGB(170, 170, 185)
                        updateKeybindDisplay(state)
                        if keyCallback then pcall(keyCallback, currentKey) end
                    end
                end)
            end)
            
            keybindBtn.MouseButton2Click:Connect(function()
                modePopup.Size = UDim2.new(0, 70, 0, 58)
                modePopup.Visible = not modePopup.Visible
            end)
            
            UserInputService.InputBegan:Connect(function(input, gameProcessed)
                if gameProcessed or binding or not currentKey then return end
                if currentMode == "Always" then return end
                
                local isTriggered = false
                if typeof(currentKey) == "EnumItem" then
                    if input.KeyCode == currentKey or input.UserInputType == currentKey then
                        isTriggered = true
                    end
                end
                
                if isTriggered then
                    if currentMode == "Toggle" then
                        updateToggle(not state)
                    elseif currentMode == "Hold" then
                        updateToggle(true)
                    end
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input, gameProcessed)
                if currentMode == "Hold" and typeof(currentKey) == "EnumItem" and currentKey then
                    if input.KeyCode == currentKey or input.UserInputType == currentKey then
                        updateToggle(false)
                    end
                end
            end)
            
            return {
                SetKey = function(newKey) currentKey = newKey; updateKeybindDisplay() end,
                SetMode = function(newMode) currentMode = newMode; updateKeybindDisplay() end
            }
        end

