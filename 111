            end)
            uiGroup:AddButton("Unload Hub", function()
                Window:Destroy()
            end)
            uiGroup:AddButton("Rejoin Game", function()
                pcall(function()
                    safeGetService(game, "TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                end)
            end)

            -- 2. Center Column: Theme Customizer
            local themeGroup = settingsTabObj:AddGroupbox("center", "Theme Customizer")

            local accPicker = themeGroup:AddLabel("Accent Color")
            themePickers["PrimaryAccent"] = accPicker:AddColorPicker(theme.PrimaryAccent, function(col)
                Window:SetThemeColor("PrimaryAccent", col)
            end)
            
            local hlPicker = themeGroup:AddLabel("Highlight Color")
            themePickers["SecondaryAccent"] = hlPicker:AddColorPicker(theme.SecondaryAccent, function(col)
                Window:SetThemeColor("SecondaryAccent", col)
            end)
            
            local borderPicker = themeGroup:AddLabel("Border Color")
            themePickers["DarkAccentBorder"] = borderPicker:AddColorPicker(theme.DarkAccentBorder, function(col)
                Window:SetThemeColor("DarkAccentBorder", col)
            end)
            
            local mainBgPicker = themeGroup:AddLabel("Window Background")
            themePickers["MainFrameBG"] = mainBgPicker:AddColorPicker(theme.MainFrameBG, function(col)
                Window:SetThemeColor("MainFrameBG", col)
            end)
            
            local innerBgPicker = themeGroup:AddLabel("Inner Background")
            themePickers["InnerFrameBG"] = innerBgPicker:AddColorPicker(theme.InnerFrameBG, function(col)
                Window:SetThemeColor("InnerFrameBG", col)
            end)

            local activeTextPicker = themeGroup:AddLabel("Active Text")
            themePickers["TextActive"] = activeTextPicker:AddColorPicker(theme.TextActive, function(col)
                Window:SetThemeColor("TextActive", col)
            end)

            local inactiveTextPicker = themeGroup:AddLabel("Inactive Text")
            themePickers["TextInactive"] = inactiveTextPicker:AddColorPicker(theme.TextInactive, function(col)
                Window:SetThemeColor("TextInactive", col)
            end)

            local logoPicker = themeGroup:AddLabel("Logo Color")
            themePickers["LogoColor"] = logoPicker:AddColorPicker(theme.LogoColor, function(col)
                Window:SetThemeColor("LogoColor", col)
            end)

            -- 3. Right Column: Config
            local configGroup = settingsTabObj:AddGroupbox("right", "Config")

            local configFrame = create("Frame", {
                Size = UDim2.new(1, 0, 0, 44),
                BackgroundTransparency = 1,
                Parent = configGroup.Container
            })

            local configLabel = create("TextLabel", {
                Size = UDim2.new(1, -20, 0, 16),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = "Config Name",
                Font = Enum.Font.Code,
                TextSize = 13,
                TextColor3 = theme.TextActive,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = configFrame
            })
            themeElements.TextActiveLabels[configLabel] = true

            local cfgBoxContainer = create("Frame", {
                Size = UDim2.new(1, -20, 0, 22),
                Position = UDim2.new(0, 10, 0, 18),
                BackgroundColor3 = theme.ControlBG,
                BorderSizePixel = 0,
                Parent = configFrame
            })

            create("UIStroke", {
                Thickness = 1.0,
                Color = theme.ControlBorder,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = cfgBoxContainer
            })

            local cfgTextBox = create("TextBox", {
                Size = UDim2.new(1, -24, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                TextSize = 12,
                TextColor3 = theme.TextActive,
                Text = "default",
                PlaceholderText = "Config Name...",
                TextXAlignment = Enum.TextXAlignment.Left,
                ClearTextOnFocus = false,
                Parent = cfgBoxContainer
            })
            themeElements.TextActiveLabels[cfgTextBox] = true

            local cfgArrowBtn = create("TextButton", {
                Size = UDim2.new(0, 20, 1, 0),
                Position = UDim2.new(1, -20, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.Code,
                TextSize = 11,
                TextColor3 = theme.TextInactive,
                Text = "v",
                Parent = cfgBoxContainer
            })

            local cfgDropdownContainer = create("ScrollingFrame", {
                Size = UDim2.new(0, 180, 0, 0),
                Position = UDim2.new(0, 0, 0, 0),
                BackgroundColor3 = theme.MainFrameBG,
                BorderSizePixel = 0,
                Visible = false,
                ClipsDescendants = true,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = theme.PrimaryAccent,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                ZIndex = 2000,
                Parent = screenGui
            })
            themeElements.MainFrameBGFills[cfgDropdownContainer] = true
            themeElements.PrimaryAccentFills[cfgDropdownContainer] = true

            create("UIStroke", {
                Thickness = 1.0,
                Color = theme.DarkAccentBorder,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = cfgDropdownContainer
            })

            create("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 2),
                Parent = cfgDropdownContainer
            })

            create("UIPadding", {
                PaddingTop = UDim.new(0, 4),
                PaddingBottom = UDim.new(0, 4),
                PaddingLeft = UDim.new(0, 4),
                PaddingRight = UDim.new(0, 4),
                Parent = cfgDropdownContainer
            })

            local function refreshConfigList()
                pcall(function()
                    for _, child in ipairs(cfgDropdownContainer:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    local fileList = getSavedConfigs()
                    local totalH = (#fileList * 20) + 8
                    cfgDropdownContainer.CanvasSize = UDim2.new(0, 0, 0, totalH)

                    for idx, fileName in ipairs(fileList) do
                        local itemBtn = create("TextButton", {
                            Size = UDim2.new(1, -6, 0, 18),
                            BackgroundTransparency = 1,
                            Font = Enum.Font.Code,
                            TextSize = 11,
                            TextColor3 = (fileName == cfgTextBox.Text) and theme.TextActive or theme.TextInactive,
                            Text = fileName,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 2001,
                            Parent = cfgDropdownContainer
                        })

                        itemBtn.MouseButton1Click:Connect(function()
                            cfgTextBox.Text = fileName
                            cfgDropdownContainer.Visible = false
                            refreshConfigList()
                        end)
                    end
                end)
            end
            refreshConfigList()

            local function toggleConfigDropdown()
                pcall(function()
                    if activeColorPicker then activeColorPicker.Visible = false end
                    cfgDropdownContainer.Visible = not cfgDropdownContainer.Visible
                    if cfgDropdownContainer.Visible then
                        refreshConfigList()
                        local fileList = getSavedConfigs()
                        local absPos = cfgBoxContainer.AbsolutePosition
                        local absSize = cfgBoxContainer.AbsoluteSize
                        local totalH = (#fileList * 20) + 8
                        cfgDropdownContainer.Size = UDim2.new(0, absSize.X, 0, math.min(totalH, 140))
                        cfgDropdownContainer.Position = UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 2)
                    end
                end)
            end

            cfgArrowBtn.MouseButton1Click:Connect(toggleConfigDropdown)

            UserInputService.InputBegan:Connect(function(input)
                if cfgDropdownContainer.Visible and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    pcall(function()
                        local pos = input.Position
                        local boxPos = cfgBoxContainer.AbsolutePosition
                        local boxSize = cfgBoxContainer.AbsoluteSize
                        local dropPos = cfgDropdownContainer.AbsolutePosition
                        local dropSize = cfgDropdownContainer.AbsoluteSize

                        local inBox = (pos.X >= boxPos.X and pos.X <= boxPos.X + boxSize.X and pos.Y >= boxPos.Y and pos.Y <= boxPos.Y + boxSize.Y)
                        local inDrop = (pos.X >= dropPos.X and pos.X <= dropPos.X + dropSize.X and pos.Y >= dropPos.Y and pos.Y <= dropPos.Y + dropSize.Y)

                        if not inBox and not inDrop then
                            cfgDropdownContainer.Visible = false
                        end
                    end)
                end
            end)

            configGroup:AddButton("Create Config", function()
                local name = cfgTextBox.Text
                if not name or name == "" then name = "default" end
                Window:SaveConfig(name)
                refreshConfigList()
            end)

            configGroup:AddButton("Load Config", function()
                local name = cfgTextBox.Text
                if not name or name == "" then name = "default" end
                Window:LoadConfig(name)
            end)

            configGroup:AddButton("Delete Config", function()
                local name = cfgTextBox.Text
                if name and name ~= "" then
                    Window:DeleteConfig(name)
                    refreshConfigList()
                    local remaining = getSavedConfigs()
                    cfgTextBox.Text = remaining[1] or "default"
                end
            end)
        end
    end)

