            local presetColors = {
                Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 200, 200), Color3.fromRGB(120, 120, 120), Color3.fromRGB(30, 30, 30),
                Color3.fromRGB(255, 50, 50),   Color3.fromRGB(255, 120, 0),   Color3.fromRGB(255, 200, 0),   Color3.fromRGB(50, 220, 50),
                Color3.fromRGB(0, 220, 220),   Color3.fromRGB(30, 140, 255),  Color3.fromRGB(150, 75, 230),  Color3.fromRGB(180, 105, 255),
                Color3.fromRGB(100, 30, 180),  Color3.fromRGB(60, 15, 120),   Color3.fromRGB(255, 0, 150),   Color3.fromRGB(180, 0, 90),
                Color3.fromRGB(180, 0, 0),     Color3.fromRGB(200, 80, 0),    Color3.fromRGB(180, 150, 0),   Color3.fromRGB(20, 140, 20),
                Color3.fromRGB(0, 140, 140),   Color3.fromRGB(10, 80, 180),   Color3.fromRGB(80, 20, 180),   Color3.fromRGB(20, 16, 26)
            }

            local colorSquareBorders = {}

            local function updateColor(newColor, skipHex)
                currentColor = newColor
                pickerBtn.BackgroundColor3 = currentColor
                for c, border in pairs(colorSquareBorders) do
                    local isMatch = (math.abs(c.R - currentColor.R) < 0.02 and math.abs(c.G - currentColor.G) < 0.02 and math.abs(c.B - currentColor.B) < 0.02)
                    border.Color = isMatch and Color3.fromRGB(255, 255, 255) or theme.ControlBorder
                    border.Thickness = isMatch and 1.8 or 1.0
                end
                if colorCallback then pcall(colorCallback, currentColor) end
            end

            for idx, colorVal in ipairs(presetColors) do
                local sqBtn = create("TextButton", {
                    Text = "",
                    AutoButtonColor = false,
                    BackgroundColor3 = colorVal,
                    BorderSizePixel = 0,
                    ZIndex = 202,
                    Parent = gridContainer
                })

                local sqStroke = create("UIStroke", {
                    Thickness = 1.0,
                    Color = theme.ControlBorder,
                    ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                    Parent = sqBtn
                })
                colorSquareBorders[colorVal] = sqStroke

                sqBtn.MouseButton1Click:Connect(function()
                    updateColor(colorVal)
                end)
            end

            local hexBox = create("TextBox", {
                Size = UDim2.new(1, -12, 0, 24),
                Position = UDim2.new(0, 6, 0, 122),
                BackgroundColor3 = theme.ControlBG,
                BorderSizePixel = 0,
                Font = Enum.Font.Code,
                TextSize = 11,
                TextColor3 = theme.TextActive,
                Text = "#" .. currentColor:ToHex():upper(),
                PlaceholderText = "#HEXCode",
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = 202,
                Parent = pickerPopup
            })

            create("UIStroke", {
                Thickness = 1.0,
                Color = theme.ControlBorder,
                ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
                Parent = hexBox
            })

            hexBox.FocusLost:Connect(function(enterPressed)
                local txt = hexBox.Text:gsub("#", "")
                if #txt == 6 then
                    local ok, parsedCol = pcall(function() return Color3.fromHex(txt) end)
                    if ok and parsedCol then
                        updateColor(parsedCol, true)
                        hexBox.Text = "#" .. parsedCol:ToHex():upper()
                    end
                end
            end)
            
            pickerBtn.MouseButton1Click:Connect(function()
                pcall(function()
                    if activeColorPicker and activeColorPicker ~= pickerPopup then
                        activeColorPicker.Visible = false
                    end
                    pickerPopup.Visible = not pickerPopup.Visible
                    if pickerPopup.Visible then
                        activeColorPicker = pickerPopup
                        activeCloseFunc = function()
                            pickerPopup.Visible = false
                            if activeColorPicker == pickerPopup then activeColorPicker = nil end
                        end
                        updateColor(currentColor)
                    else
                        if activeColorPicker == pickerPopup then activeColorPicker = nil end
                    end
                end)
            end)
            
            return {
                SetColor = updateColor,
                GetColor = function() return currentColor end
            }
        end
        
        return toggleObj
    end
    
    -- Method: Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
    function Window:AddSlider(columnParent, text, min, max, defaultVal, suffix, callback)
        if type(min) == "string" then
            local tempText = min
            local tempMin = max
            local tempMax = defaultVal
            local tempDef = suffix
            local tempSuf = callback
            text = tempText
            min = tempMin or 0
            max = tempMax or 100
            defaultVal = tempDef or min
            suffix = tempSuf or ""
            callback = arguments and arguments[6]
        end
        
        min = min or 0
        max = max or 100
        defaultVal = math.clamp(defaultVal or min, min, max)
        suffix = suffix or ""
        
        local sliderFrame = create("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundTransparency = 1,
            Parent = columnParent or (Window.Tabs and Window.Tabs["Rage"] and Window.Tabs["Rage"].LeftColumn)
        })
        
        local sliderLabel = create("TextLabel", {
            Size = UDim2.new(0.65, 0, 0, 16),
            Position = UDim2.new(0, 10, 0, 0),
            BackgroundTransparency = 1,
            Text = text or "Slider",
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = theme.TextActive,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = sliderFrame
        })
        
        local valueLabel = create("TextLabel", {
            Size = UDim2.new(0.35, -10, 0, 16),
            Position = UDim2.new(0.65, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = tostring(defaultVal) .. suffix,
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = theme.SecondaryAccent,
            TextXAlignment = Enum.TextXAlignment.Right,
            Parent = sliderFrame
        })
        
        local track = create("TextButton", {
            Size = UDim2.new(1, -20, 0, 8),
            Position = UDim2.new(0, 10, 0, 20),
            BackgroundColor3 = theme.ControlBG,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            Parent = sliderFrame
        })
        
        local trackStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = theme.ControlBorder,
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = track
        })
        
        local fillPercent = (defaultVal - min) / math.max(1, max - min)
        local fill = create("Frame", {
            Size = UDim2.new(fillPercent, 0, 1, 0),
            BackgroundColor3 = theme.PrimaryAccent,
            BorderSizePixel = 0,
            Parent = track
        })
        
        local fillStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = theme.SecondaryAccent,
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = fill
        })
        
        local currentValue = defaultVal
        local sliding = false
        
        local function updateSlider(inputPos)
            pcall(function()
                local trackAbsPos = track.AbsolutePosition.X
                local trackAbsSize = track.AbsoluteSize.X
                local relX = math.clamp(inputPos.X - trackAbsPos, 0, trackAbsSize)
                local pct = relX / trackAbsSize
                
                currentValue = math.floor(min + (max - min) * pct + 0.5)
                currentValue = math.clamp(currentValue, min, max)
                
                fill.Size = UDim2.new(pct, 0, 1, 0)
                valueLabel.Text = tostring(currentValue) .. suffix
                
                if callback then
                    pcall(callback, currentValue)
                end
            end)
        end
        
        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                updateSlider(input.Position)
            end
        end)
        
        track.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateSlider(input.Position)
            end
        end)
        
        return {
            SetValue = function(val)
                currentValue = math.clamp(val, min, max)
                local pct = (currentValue - min) / math.max(1, max - min)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                valueLabel.Text = tostring(currentValue) .. suffix
                if callback then pcall(callback, currentValue) end
            end,
            GetValue = function() return currentValue end
        }
    end

