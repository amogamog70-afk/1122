    -- ====================================================================
    -- FULL JSON CONFIG FILE SYSTEM (Executor writefile/readfile/listfiles)
    -- ====================================================================
    local CONFIG_FOLDER = "LunexHub"
    local CONFIG_PATH = "LunexHub/Configs"

    local function ensureConfigFolder()
        pcall(function()
            if typeof(makefolder) == "function" and typeof(isfolder) == "function" then
                if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
                if not isfolder(CONFIG_PATH) then makefolder(CONFIG_PATH) end
            end
        end)
    end

    local function getSavedConfigs()
        ensureConfigFolder()
        local configs = {}
        pcall(function()
            if typeof(listfiles) == "function" and typeof(isfolder) == "function" then
                if isfolder(CONFIG_PATH) then
                    local files = listfiles(CONFIG_PATH)
                    for _, filePath in ipairs(files) do
                        local fileName = filePath:match("([^/\\]+)%.json$")
                        if fileName then
                            table.insert(configs, fileName)
                        end
                    end
                end
            end
        end)
        if #configs == 0 then
            table.insert(configs, "default")
        end
        table.sort(configs)
        return configs
    end

    function Window:SaveConfig(cfgName)
        ensureConfigFolder()
        if not cfgName or cfgName == "" then cfgName = "default" end
        cfgName = cfgName:gsub("[^%w_%-]", "")
        
        local data = {
            Theme = {
                PrimaryAccent = theme.PrimaryAccent:ToHex(),
                SecondaryAccent = theme.SecondaryAccent:ToHex(),
                DarkAccentBorder = theme.DarkAccentBorder:ToHex(),
                MainFrameBG = theme.MainFrameBG:ToHex(),
                InnerFrameBG = theme.InnerFrameBG:ToHex(),
                TextActive = theme.TextActive:ToHex(),
                TextInactive = theme.TextInactive:ToHex(),
                LogoColor = theme.LogoColor:ToHex(),
            },
            UI = {
                WatermarkVisible = wmVisible,
                KeybindListVisible = keybindFrame.Visible
            },
            Flags = {}
        }

        for flagName, item in pairs(registry) do
            pcall(function()
                if item.Type == "Toggle" then
                    data.Flags[flagName] = item.Object:GetState()
                elseif item.Type == "Slider" then
                    data.Flags[flagName] = item.Object:GetValue()
                elseif item.Type == "Dropdown" then
                    data.Flags[flagName] = item.Object:GetSelected()
                elseif item.Type == "MultiDropdown" then
                    data.Flags[flagName] = item.Object:GetSelectedMap()
                elseif item.Type == "Keybind" then
                    local key = item.Object:GetKey()
                    data.Flags[flagName] = {
                        Key = key and (typeof(key) == "EnumItem" and key.Name or tostring(key)) or nil,
                        Mode = item.Object:GetMode()
                    }
                elseif item.Type == "ColorPicker" then
                    local col = item.Object:GetColor()
                    data.Flags[flagName] = col and col:ToHex() or nil
                end
            end)
        end

        local okStr, jsonStr = pcall(function() return HttpService:JSONEncode(data) end)
        if not okStr or not jsonStr then
            Window:Notify("Lunex Hub", "Failed to encode JSON for " .. cfgName, 3.5)
            return
        end

        local fullPath = CONFIG_PATH .. "/" .. cfgName .. ".json"
        
        if typeof(writefile) == "function" then
            pcall(writefile, fullPath, jsonStr)
            Window:Notify("Lunex Hub", "Config saved: " .. cfgName .. ".json", 3.5)
        else
            Window:Notify("Lunex Hub", "Executor does not support writefile!", 3.5)
        end
    end

    function Window:LoadConfig(cfgName)
        ensureConfigFolder()
        if not cfgName or cfgName == "" then cfgName = "default" end
        cfgName = cfgName:gsub("[^%w_%-]", "")
        local fullPath = CONFIG_PATH .. "/" .. cfgName .. ".json"
        
        if typeof(readfile) ~= "function" then
            Window:Notify("Lunex Hub", "Executor does not support readfile!", 3.5)
            return
        end

        local success, content = pcall(readfile, fullPath)
        if not success or not content or #content == 0 then
            Window:Notify("Lunex Hub", "Failed to read " .. cfgName .. ".json", 3.5)
            return
        end

        local ok, data = pcall(function() return HttpService:JSONDecode(content) end)
        if not ok or not data then
            Window:Notify("Lunex Hub", "Corrupted JSON in " .. cfgName .. ".json", 3.5)
            return
        end

        pcall(function()
            -- 1. Restore Theme & Theme Pickers
            if data.Theme then
                for prop, hex in pairs(data.Theme) do
                    pcall(function()
                        local col = Color3.fromHex(hex)
                        if col then
                            Window:SetThemeColor(prop, col)
                            if themePickers[prop] then
                                pcall(function() themePickers[prop]:SetColor(col) end)
                            end
                        end
                    end)
                end
            end

            -- 2. Restore UI Visibility
            if data.UI then
                if data.UI.WatermarkVisible ~= nil then Window:SetWatermarkVisibility(data.UI.WatermarkVisible) end
                if data.UI.KeybindListVisible ~= nil then Window:SetKeybindListVisibility(data.UI.KeybindListVisible) end
            end

            -- 3. Restore Flags (All Toggles, Sliders, Dropdowns, Keybinds, ColorPickers)
            if data.Flags then
                for flagName, val in pairs(data.Flags) do
                    local item = registry[flagName]
                    if item then
                        pcall(function()
                            if item.Type == "Toggle" and typeof(val) == "boolean" then
                                item.Object:SetState(val)
                            elseif item.Type == "Slider" and typeof(val) == "number" then
                                item.Object:SetValue(val)
                            elseif item.Type == "Dropdown" then
                                local strVal = (type(val) == "table" and val[1]) or val
                                item.Object:SetSelected(tostring(strVal or ""))
                            elseif item.Type == "MultiDropdown" and type(val) == "table" then
                                for opt, st in pairs(val) do
                                    item.Object:SetOption(opt, st)
                                end
                            elseif item.Type == "Keybind" and type(val) == "table" then
                                if val.Key then
                                    local enumKey = Enum.KeyCode[val.Key] or Enum.UserInputType[val.Key]
                                    item.Object:SetKey(enumKey or val.Key)
                                else
                                    item.Object:SetKey(nil)
                                end
                                if val.Mode then
                                    item.Object:SetMode(val.Mode)
                                end
                            elseif item.Type == "ColorPicker" and type(val) == "string" then
                                local ok, col = pcall(Color3.fromHex, val)
                                if ok and col then
                                    item.Object:SetColor(col)
                                end
                            end
                        end)
                    end
                end
            end
        end)

        Window:Notify("Lunex Hub", "Loaded config: " .. cfgName .. ".json", 3.5)
    end

    function Window:DeleteConfig(cfgName)
        ensureConfigFolder()
        if not cfgName or cfgName == "" then return end
        cfgName = cfgName:gsub("[^%w_%-]", "")
        local fullPath = CONFIG_PATH .. "/" .. cfgName .. ".json"
        if typeof(delfile) == "function" then
            pcall(delfile, fullPath)
            Window:Notify("Lunex Hub", "Deleted config: " .. cfgName .. ".json", 3.5)
        end
    end

    function Window:GetSavedConfigs()
        return getSavedConfigs()
    end

    -- Toggle Window Visibility with Keybind (RightShift)
    local toggleConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Enum.KeyCode.RightShift then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)
    
    function Window:Destroy()
        pcall(function()
            if fpsConn then fpsConn:Disconnect() end
            if wmLoopTask then task.cancel(wmLoopTask) end
            if toggleConnection then toggleConnection:Disconnect() end
            if screenGui then screenGui:Destroy() end
        end)
    end
    Window.Destroy = Window.Destroy
    
    -- ====================================================================
    -- BUILT-IN AUTOMATIC SETTINGS TAB BUILDER (UI Settings, Theme Customizer, Config)
    -- ====================================================================
    pcall(function()
        local settingsTabObj = Window.Tabs["Settings"]
        if settingsTabObj then
            -- 1. Left Column: UI Settings
            local uiGroup = settingsTabObj:AddGroupbox("left", "UI Settings")
            uiGroup:AddToggle("Show Watermark", true, function(state)
                Window:SetWatermarkVisibility(state)
