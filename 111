    -- Method: Window:AddToggle(columnParent, text, defaultState, callback)
    function Window:AddToggle(columnParent, text, defaultState, callback)
        local toggleFrame = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            Parent = columnParent or (Window.Tabs and Window.Tabs["Rage"] and Window.Tabs["Rage"].LeftColumn)
        })
        
        local state = defaultState or false
        local activeKeybindUpdateFunc = nil
        
        local toggleBox = create("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 10, 0, 3),
            BackgroundColor3 = state and theme.PrimaryAccent or theme.ControlBG,
            BorderSizePixel = 0,
            Parent = toggleFrame
        })
        
        local toggleStroke = create("UIStroke", {
            Thickness = 1.0,
            Color = state and theme.SecondaryAccent or theme.ControlBorder,
            LineJoinMode = Enum.LineJoinMode.Miter,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
            Parent = toggleBox
        })
        
        local toggleLabel = create("TextLabel", {
            Size = UDim2.new(1, -85, 0, 20),
            Position = UDim2.new(0, 32, 0, 0),
            BackgroundTransparency = 1,
            Text = text or "Toggle",
            Font = Enum.Font.Code,
            TextSize = 13,
            TextColor3 = state and theme.TextActive or theme.TextInactive,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = toggleFrame
        })
        themeElements.TextActiveLabels[toggleLabel] = true
        
        local function updateToggle(newState)
            state = newState
            local boxColor = state and theme.PrimaryAccent or theme.ControlBG
            local strokeColor = state and theme.SecondaryAccent or theme.ControlBorder
            local textColor = state and theme.TextActive or theme.TextInactive
            
            if state then
                themeElements.PrimaryAccentFills[toggleBox] = true
                themeElements.SecondaryAccentStrokes[toggleStroke] = true
            else
                themeElements.PrimaryAccentFills[toggleBox] = nil
                themeElements.SecondaryAccentStrokes[toggleStroke] = nil
            end
            
            TweenService:Create(toggleBox, TweenInfo.new(0.15), {BackgroundColor3 = boxColor}):Play()
            TweenService:Create(toggleStroke, TweenInfo.new(0.15), {Color = strokeColor}):Play()
            TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = textColor}):Play()
            
            if activeKeybindUpdateFunc then
                activeKeybindUpdateFunc(state)
            end
            
            if callback then
                pcall(callback, state)
            end
        end
        
        toggleFrame.MouseButton1Click:Connect(function()
            updateToggle(not state)
        end)
        
        toggleFrame.MouseEnter:Connect(function()
            if not state then
                TweenService:Create(toggleLabel, TweenInfo.new(0.15), {TextColor3 = theme.TextHover}):Play()
            end
        end)
        
        toggleFrame.MouseLeave:Connect(function()
            if not state then
